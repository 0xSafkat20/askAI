# Copy this file to .env.local and restart npm run dev.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use the publishable key (sb_publishable_...) or legacy anon key. Never service_role.
SUPABASE_PUBLISHABLE_KEY=

# Optional generated answers. Without a key, retrieved passages are returned.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
